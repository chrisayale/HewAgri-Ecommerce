{
  "expo": {
    "name": "POS HewAgri",
    "slug": "pos-app-ecom",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ecomkgreen.app",
      "buildNumber": "1.0.1",
      "infoPlist": {
        "NSCameraUsageDescription": "Hewagri démande accès à la camera pour scanner le QRCode au processus de paiement de transport",
        "NSPhotoLibraryUsageDescription": "Hewagri démande un accès à votre librairie pour vous pemettre de séléctionner une image de profile",
        "NSUserActivityTypes": [
          "INSendMessageIntent"
        ]
      }
    },
    "android": {
      "package": "com.ecomkgreen.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "display": "standalone",
      "themeColor": "#2E7D32",
      "backgroundColor": "#ffffff",
      "scope": "/",
      "startUrl": "/",
      "manifest": {
        "name": "POS HewAgri",
        "short_name": "HewAgri POS",
        "description": "Point of Sale HewAgri - Application de vente pour KivuGreen",
        "orientation": "portrait",
        "display": "standalone",
        "theme_color": "#2E7D32",
        "background_color": "#ffffff",
        "scope": "/",
        "start_url": "/",
        "icons": [
          {
            "src": "/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any maskable"
          },
          {
            "src": "/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any maskable"
          }
        ],
        "categories": ["business", "productivity", "finance"],
        "shortcuts": [
          {
            "name": "Nouvelle Vente",
            "short_name": "Vente",
            "description": "Commencer une nouvelle vente",
            "url": "/",
            "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
          },
          {
            "name": "Scanner Produit",
            "short_name": "Scanner",
            "description": "Scanner un code-barres",
            "url": "/scanner",
            "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
          }
        ]
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Balabala démande accès à la camera pour scanner le QRCode au processus de paiement de transport"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff",
          "mode": "production"
        }
      ],
      "react-native-nfc-manager"
    ]
  }
}
